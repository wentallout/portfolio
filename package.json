    "postcss": "^8.5.26",
    "postcss-import": "^17.0.0",
    "postcss-preset-env": "^11.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
