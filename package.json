{
  "name": "portfolio",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "pnpm": ">=11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wentallout/portfolio"
  },
  "bugs": {
    "url": "https://github.com/wentallout/portfolio/issues"
  },
  "scripts": {
    "dev": "vite dev --host --open",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check",
    "check:watch": "svelte-check --watch",
    "lint:stylelint": "stylelint \"src/**/*.{css,svelte}\"",
    "format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. .",
    "ngrok": "ngrok http 4173",
    "test": "pnpm exec playwright test",
    "test:debug": "pnpm exec playwright test --debug",
    "test:ui": "pnpm exec playwright test --ui",
    "test:report": "pnpm exec playwright show-report",
    "knip": "knip"
  },
