	"scripts": {
		"dev": "vite dev --host --open",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check",
		"check:watch": "svelte-check --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:stylelint": "stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. .",
		"format:fix": "prettier --ignore-path .gitignore --write --plugin-search-dir=. . && pnpm lint:fix",
		"ngrok": "ngrok http 1111",
		"test": "pnpm exec playwright test",
		"test:e2e": "pnpm exec playwright test",
		"test:debug": "pnpm exec playwright test --debug",
		"test:ui": "pnpm exec playwright test --ui",
		"test:report": "pnpm exec playwright show-report",
		"test:unit": "vitest run --project=client",
		"test:unit:watch": "vitest --project=client",
		"test:server": "vitest run --project=server",
		"test:ssr": "vitest run --project=ssr",
		"test:all": "vitest run",
		"knip": "knip"
	},
