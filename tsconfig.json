{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"types": ["vitest-browser-svelte", "$app/types"],
		"allowJs": false,
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"noErrorTruncation": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": false,
		"verbatimModuleSyntax": true
	},
	"exclude": [
		"node_modules/**",
		".svelte-kit/**",
		"build/**",
		"dist/**",
		".netlify/**",
		"playwright-report/**",
		"test-results/**",
		"coverage/**",
		"static/**",
		"src/service-worker/**/*"
	]
}
