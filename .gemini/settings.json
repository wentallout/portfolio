{
	"mcpServers": {
		"svelte": {
			"command": "npx",
			"args": [
				"-y",
				"@sveltejs/mcp"
			]
		},
		"Neon": {
			"type": "http",
			"url": "https://mcp.neon.tech/mcp"
		},
		"frontendchecklist": {
			"type": "http",
			"url": "https://mcp.frontendchecklist.io"
		}
	},
	"general": {
		"defaultApprovalMode": "auto_edit"
	},
	"security": {
		"enablePermanentToolApproval": true
	}
}
