# Copy to .env and fill Cloudinary values from https://cloudinary.com/console
# See src/lib/server/cloudinary.ts
DATABASE_URL="postgresql://..."
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Alternative split vars (if not using CLOUDINARY_URL):
# CLOUDINARY_CLOUD_NAME=<cloud_name>
# CLOUDINARY_API_KEY=<api_key>
# CLOUDINARY_API_SECRET=<api_secret>

# Security — studio CMS (secret, admin-only)
# CMS_ADMIN_EMAIL is the single allowed Google account; CMS_ALLOWED_IPS optionally restricts /studio to your IPs
# ARCJET_KEY enables DDoS / brute-force / bot shielding (https://app.arcjet.com)
CMS_ADMIN_EMAIL="you@example.com"
CMS_ALLOWED_IPS="" # comma-separated, e.g. "1.2.3.4,5.6.7.8" (empty = any IP, extra UI logs)
ARCJET_KEY="ajkey_..."
NEON_AUTH_BASE_URL="https://...neonauth.../neondb/auth"
NEON_AUTH_JWKS_URL="https://...neonauth.../neondb/auth/.well-known/jwks.json"
